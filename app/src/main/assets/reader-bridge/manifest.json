{
  "manifest_version": 2,
  "name": "FlipRSS Reader Bridge",
  "version": "1.0.0",
  "description": "Returns visible article text only when the FlipRSS reader requests it.",
  "browser_specific_settings": {"gecko": {"id": "reader-bridge@fliprss.app"}},
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["reader.js"], "all_frames": false, "run_at": "document_idle"}]
}
